{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARAM Balance Checker",
  "version": "0.1.0",
  "identifier": "fr.forhives.aram-balance-checker",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ARAM Balance Checker",
        "width": 1200,
        "height": 820,
        "minWidth": 420,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://raw.communitydragon.org data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "ARAM and ARAM: Mayhem balance of the champions in your champion select",
    "copyright": "Data: League of Legends Wiki (CC BY-SA 3.0). Not endorsed by Riot Games.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFODJFRjZCMjZFNUIyRkYKUldUL3N1VW1hKytDYmlJMGlvWGVaR1A1OXJsMlppN0Y4MElKWjM2RmxHcU1LWVlUenBQVGpUajYK",
      "endpoints": [
        "https://github.com/CinquinAndy/next-aram-buff-debuff/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
